    "alpha_or_schedule": null
  },
  "gradient_definitions": {
    "local_leaf_semantics": "Unit-norm pre-normalization leaves are normalized again inside the graph; autograd therefore returns tangent-space gradients (I - xx^T) grad_x at the unit-norm evaluation point.",
